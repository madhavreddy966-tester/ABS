<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name = "Grouping Suite">
    <listeners>
        <listener class-name="utilities.ExtentReportManager" />
    </listeners>
    <groups>
        <run>
            <include name = "sanity" />
            <!-- <include name = "DDT"/> -->
        </run>
    </groups>
    <test name="Test">
        <parameter name= "browser"
                   value="chrome" />
        <classes>
            <class name="testCases.TC_Login001" />
            <class name="testCases.TC_LoginDDT002" />
        </classes>
    </test>
</suite>